// Gara Radar — Cloudflare-first migration target
// Optional Vite Flare bindings stay in source as reference modules but are NOT
// provisioned until Gara Radar needs them. This keeps the first deployment small.
{
  "name": "gara-radar-v2-preview",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat_v2"],
  "main": "./src/server/index.ts",

  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/mcp/*", "/llms.txt"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gara-radar-v2-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  "vars": {
    "APP_NAME": "Gara Radar",
    "NODE_ENV": "preview",
    "ENABLE_EMAIL_LOGIN": "true",
    "ENABLE_EMAIL_SIGNUP": "true",
    "ENABLE_MAGIC_LINK": "false",
    "ENABLE_PASSKEYS": "false",
    "VITE_APP_NAME": "Gara Radar",
    "VITE_APP_ID": "gara-radar",
    "VITE_TOKEN_PREFIX": "grr_",
    "VITE_GITHUB_URL": "https://github.com/soliwkr/gara-radar",
    "VITE_DEFAULT_BUILDER_MODE": "false"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
